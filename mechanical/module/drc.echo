ECHO: "DRC", "INFO", "tbd parameters in play", 18, ["panel_washer_t", "rail_band", "rail_depth", "power_ribbon_t", "tall_cap_h", "jack_nut_d", "jack_nut_h", "jack_plug_d", "knob_gap", "led_spacer_d", "led_proud", "toggle_nut_d", "toggle_nut_h", "ethercon_umb_od", "ethercon_umb_bend_k", "ethercon_screw_head_d", "ethercon_screw_head_h", "art_resp_marks"]
ECHO: "DRC", "INFO", "panel", [50.5, 128.5, 2], "mm: width, height, thickness (A-100, 10HP) - panel-width, panel-height-budget"
ECHO: "DRC", "PASS", "knob to knob at the 14 mm budget", 3, "mm between knob skirts at KNOB-BREATH's maximum diameter (knob POT-GAIN / knob POT-OFFSET); ADR 0004 wants 3"
ECHO: "DRC", "PASS", "knob to knob, the chosen knob", 5, "mm between the Thonk 1900h's 12 mm skirts (KNOB-BREATH, proposed)"
ECHO: "DRC", "PASS", "knob inside the panel's side edges", 1.25, "mm, a 14 mm knob to the nearest panel edge"
ECHO: "DRC", "PASS", "jack to jack: plug grip to plug grip", 3, "mm (plug J-CV-PITCH / plug J-CV-MOD1); 13 down a column, 19 across"
ECHO: "DRC", "PASS", "plug grip to knob", 7.03943, "mm (plug J-CV-PITCH / knob POT-GAIN)"
ECHO: "DRC", "PASS", "plugs and knobs clear of the NE8MX, the PUSH tab, the toggle, the LED and the A-screws", 4.16373, "mm (plug J-CV-MOD3 / SW-POWER sweep)"
ECHO: "DRC", "PASS", "face parts clear of each other", 2.15, "mm (PUSH tab / A-screw head)"
ECHO: "DRC", "PASS", "NE8MX clear of the toggle's sweep and the LED", 9.85, "mm (SW-POWER sweep); it covers its own tab and screws by design"
ECHO: "DRC", "PASS", "no panel control under the umbilical: clear of the NE8MX's grip and its cable's drop zone", 9.85, "mm (SW-POWER sweep / NE8MX grip); the zone is the NE8MX's 20.1 grip and a strip that wide from the axis down past the panel's bottom edge"
ECHO: "DRC", "PASS", "the umbilical's plug stands proud of every control", [29.7, 17], "mm in front of the panel's front face: the NE8MX's back at least (its short length, fully home to the NE8FAV's PCB face), against the tallest thing on the face - so no control gets out from under the cable by being taller, and the drop zone holds at every height"
ECHO: "DRC", "INFO", "the umbilical's bend", [24, 50.7, 1], "mm: the cable's bend radius (tbd: umb_bend_k x umb_od); how far in front of the panel its hanging run stands, at least; and how far above the panel's bottom edge the bend has turned it straight down"
ECHO: "DRC", "PASS", "everything on the face clear of the panel screws' washers", 0, "mm (title band); a washer anywhere along its slot, panel_washer_od - the clear height panel-height-budget derives"
ECHO: "DRC", "PASS", "title band above the knobs", 4, "mm, the band's foot above a 14 mm knob's top"
ECHO: "DRC", "PASS", "panel web between two parts' cuts", 6.7, "mm of aluminium (J-CV-PITCH / J-CV-MOD1)"
ECHO: "DRC", "PASS", "panel web from a cut to the panel's edge", 4.75, "mm (the standard mounting slots excepted)"
ECHO: "DRC", "PASS", "panel web from a cut to a mounting slot", 9.94929, "mm (J-UMBILICAL screw)"
ECHO: "DRC", "INFO", "NE8FAV cut-out's own web, bore to screw hole", 1.30071, "mm - Neutrik's pattern (ST-NE8FAV), not a layout choice"
ECHO: "DRC", "NOTE", "mounting slots", [[7.5, 43.06], [3, 125.5], 3.2, 3], "mm: slot centres x, y; width; centre travel - Doepfer's holes, slotted as the banked fabricated panel is"
ECHO: "DRC", "PASS", "panel within the NE8FAV's maximum", 1, "mm to spare"
ECHO: "DRC", "PASS", "panel within the toggle's maximum", 0.6, "mm to spare (NKK, standard hardware)"
ECHO: "DRC", "PASS", "PUSH tab clear of the panel - no slot", 1.8, "mm between the panel's front face and the tab's plate (ADR 0024); the stem passes inside the bore"
ECHO: "DRC", "PASS", "PUSH tab's stem rises inside the bore", 1.2, "mm, the tab's foot inside the bore's edge; the STEP has nothing of the NE8FAV outside a 22 circle within 3.8 of the flange face (ethercon.tab_back)"
ECHO: "DRC", "PASS", "jack bushing leaves thread for its nut", 1.5, "mm past the nut"
ECHO: "DRC", "PASS", "toggle bushing leaves thread for its nut", 4.9, "mm past the nut"
ECHO: "DRC", "PASS", "pot bracket behind the panel", 1.2, "mm between the R0904N's bracket and the panel's rear face (it has no bushing: the board locates it)"
ECHO: "DRC", "NOTE", "pot shaft stands in front of the panel", 14, "mm; the knob's bore must be at least 13 deep for it to sit knob.gap off the face - read it off the knob at the first fit"
ECHO: "DRC", "PASS", "LED lead spacer length (derived)", 6.45, "mm, the jack board's front face to the LED flange's underside - MECH-LED-BEZEL-MOD's length"
ECHO: "DRC", "INFO", "stack depths behind the panel's rear face", [9, 10.6, 18.3, 19.9], "mm: jack board front and rear, main board front and rear - set by the PJ398SM's body and the NE8FAV's setback"
ECHO: "DRC", "PASS", "standoff length (derived)", 7.7, "mm between the boards = the NE8FAV's setback less the jack's body and the jack board (MECH-STANDOFF-MOD)"
ECHO: "DRC", "PASS", "standoff faced from stock", [8, 0.3], "mm: the stock length, and what comes off it (a stock part is +/-0.1; face it and measure it, as the key boards' spacer)"
ECHO: "DRC", "NOTE", "J-B2B-MOD pin length (derived)", 13.9, "mm = 1.5 proud of the jack board + 1.6 + the gap + 1.6 + 1.5 out of the main board"
ECHO: "DRC", "PASS", "boards inside the rail band", [10, 118.5], "mm, the boards' bottom and top edges (rail.band is tbd)"
ECHO: "DRC", "PASS", "boards inside the panel's width", [1, 1], "mm inside each side edge"
ECHO: "DRC", "INFO", "board outlines", [[1, 10, 49.5, 118.5], [11.75, 38.75, 38.5], [17.75, 32.75, 38.5, 54.45]], "mm: [x0, y0, x1, y1] of both; the jack board's notch [x0, x1, top], open to its bottom edge, and its step for SW-POWER [x0, x1, y0, top] above it"
ECHO: "DRC", "INFO", "jack board legs beside the notch", [10.75, 10.75], "mm wide, left and right"
ECHO: "DRC", "PASS", "jack board notch clear of the NE8FAV's body", 1, "mm each side and above"
ECHO: "DRC", "PASS", "jack board notch clear of SW-POWER's body", [1, 8.05], "mm: the least of each side and above; and the toggle's body above the NE8FAV's body, behind the panel"
ECHO: "DRC", "PASS", "parts behind the panel clear of the rail band", 0.7, "mm (standoff screw head); rail.band is tbd"
ECHO: "DRC", "PASS", "toggle's lugs in front of the main board", 4.4, "mm between the lugs' ends and the main board's front face - room for the wires' bends"
ECHO: "DRC", "PASS", "standoff screw heads clear of the jack board's front-face parts", 1.93406, "mm (POT-OFFSET)"
ECHO: "DRC", "PASS", "standoff screw heads inside the boards' edges and the notch", 0.7, "mm, a head's edge to the nearest board edge"
ECHO: "DRC", "PASS", "standoff screw heads clear of the main board's rear-face parts", 1.015, "mm (J-PWR-EURO)"
ECHO: "DRC", "PASS", "main board rear-face parts clear of each other", 1.72, "mm (tall trim 5 / tall trim 6)"
ECHO: "DRC", "PASS", "standoffs clear of the NE8FAV and J-B2B-MOD between the boards", 2.9109, "mm (J-UMBILICAL body)"
ECHO: "DRC", "PASS", "J-B2B-MOD's pads clear of the jacks' footprints", 1.16, "mm (J-CV-PITCH footprint), between the two jack columns"
ECHO: "DRC", "PASS", "jack footprints clear of each other", 4, "mm (J-CV-PITCH footprint / J-CV-MOD1 footprint): body and pads, 13.85 along the pin line, which lies across the panel"
ECHO: "DRC", "PASS", "why the jacks lie on their sides", [13.85, 13], "mm: a PJ398SM's footprint along its pin line, against the column's pitch - pins down the column would put one jack's sleeve pad on the next one's tip pad"
ECHO: "DRC", "PASS", "jack pads inside the board's side edges", 7.12, "mm, a sleeve pad's edge to the board's edge"
ECHO: "DRC", "PASS", "lowest jacks above the notch", 3.55, "mm, the lowest footprint's edge to the notch's top edge (its step for SW-POWER)"
ECHO: "DRC", "PASS", "LED spacer on the jack board's leg", 3.375, "mm, the spacer's edge to the leg's edges (the LED's leads are soldered in the leg)"
ECHO: "DRC", "PASS", "depth behind the panel, against the Intellijel Palette", [38.8, 6.7], "mm behind the rear face, and to spare (the mated power socket with its ribbon folded over it)"
ECHO: "DRC", "PASS", "depth from the panel's FRONT face, against the same", [40.8, 4.7], "mm - the Palette's manual does not say which face its 45.5 is from; this is the worse reading"
ECHO: "DRC", "INFO", "depths of the deep things", [["the mated power socket with its ribbon folded over it", 38.8], ["J-PWR-EURO shroud", 28.95], ["tallest bulk cap (tbd height)", 30.9], ["trimmer", 29.93], ["NE8FAV tails", 21.7]], "mm behind the rear face"
ECHO: "DRC", "INFO", "tallest thing in front of the panel", 17, "mm from the front face (the knob, unless the toggle's lever is longer)"
