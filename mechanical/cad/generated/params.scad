hardware_kb_washer_t = 0.3;  // nominal; an M2 small flat washer, ISO 7092 / DIN 433, between the spacer and the key board: 0.30 -0.05/+0.05 [datasheets/mechanical/ASPEN-ME351-2-M2-ISO7092-DIN433-WASHER-DRAWING.pdf]
