logo_artwork = "scs-orbit-wave-mark";  // settled; owner, 2026-10-01 ('use main's newest branding'): branding/export/scs-orbit-wave-mark.dxf, the Space Coast Synthesizers orbit-wave mark - five closed outlines, black = etched. woody_body.scad imports that file by a literal path (cad.py's dependency walk reads literals) and asserts it is this one
logo_scale = 0.509;  // settled; owner, 2026-10-01: 'The circle diameter of the instrument needs to match the key size in diameter' and 'the smallest possible without having that issue... I'm okay with the diameter being slightly bigger than the key... particularly if we're talking about just the inside of the circle diameter'. So the ring's INSIDE diameter equals the keycap (switch.keycap, 16.5): branding/README gives the ring a 36.0 centreline and 3.6 band, inside 32.4 at 100 %, so 16.5 / 32.4 = 0.509 [calc]; outside 20.2. The mark's own 2.0 clearances then scale to 1.02, just over logo.laser_min_gap, which is what 'without having that issue' asks - any smaller and the etch's parts run together [drc.echo 'logo: smallest gap in the etch']
logo_rotation = 90;  // nominal; degrees, the artwork turned so its top faces the mouth end: the mark reads upright in the plan drawings (mouthpiece at the top) and to an audience facing a player holding the instrument mouth-up, which is how a maker's mark on a played instrument is read; the player sees it inverted. Turned this way its wide axis (the wave) runs across the body, the only way it fits the band at a readable size - along the body its wave, not its ring, would have to fit the band's length, about three quarters of this scale [calc: the mark's height over its width, branding/export/spec.json]
logo_offset = [0.0, 0.0];  // nominal; mm from the band's centre (along the body) and the centreline (across): centred, so the margins to the seam and the slot are equal
logo_margin_min = 3.0;  // nominal; owner's brief, 2026-10-01: at least ~3 mm of plain oak between the mark's extent and the mouth cap's seam, the first cap slot, and the long edges' roundover flat - less and the mark reads as crowded against a joint or a moving cap [drawing convention]
logo_depth = 1.0;  // nominal; etch depth into the oak top: branding/README.md 'Colour fill (dark woods)' - etched deeper than a plain burn (its 'Etching notes' range) so the epoxy has something to key into. drc.echo 'logo etch leaves wood over the column screw pockets' checks the oak left under it
logo_fill = "epoxy";  // nominal; branding/README.md 'Colour fill (dark woods)': the etch filled with pigmented epoxy and sanded flush, in its scheme (wave and moon one colour, ring another; `EPOXY` in branding/build.py), because the top is dark-stained oak (ADR 0009 'Finishes'). 'plain' = a bare etch, no fill solids drawn
logo_laser_min_gap = 1.0;  // tbd; the narrowest wall of oak a raster etch leaves standing between two etched areas without burning through or chipping out in oak [from memory - no banked figure]. drc.echo 'logo: smallest gap in the etch' fails under it, and notes the gap if it is under the mark's own clearance at 100 % (branding/README.md 'Geometry', the laser guideline)

