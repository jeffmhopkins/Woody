ethercon_tab_front = 6.8;  // settled; [ds 3D] NEUTRIK-NE8FAV-3D.stp - 6.8 in front of the flange face; the drawing's 24.3 overall is to the same tab, from the rear latch
ethercon_pin_rows = [2.11, 4.65];  // settled; [ds] ST-NE8FAV PCB layout - the two contact rows, 2.54 apart, the upper at 4.65 above the peg line through the axis
ethercon_g_below = 10.55;  // settled; [ds] ST-NE8FAV PCB layout - G (d1.2) 15.2 below the upper row [calc: 15.2 - 4.65]
ethercon_peg_below = 1.5;  // settled; [ds 3D] NEUTRIK-NE8FAV-3D.stp - two d1.5 locating pegs stand 1.5 below the flange's lower edge (the drawing's front view shows them). Standing on the floor, latch up, they point into the oak bottom, so they are CUT OFF FLUSH at assembly (ADR 0021): drilling the floor for them would locate the connector twice, by the cap and by the floor
ethercon_recess_margin = 1.0;  // tbd; the tail cap's outside recess round the flange's outline and the PUSH tab [placeholder]
ethercon_rotated = false;  // settled; [adr] ADR 0021 - the NE8FAV's flange is square, so ADR 0009's reason to turn the NE8FDP is gone; latch up, the PUSH tab on top
ethercon_offset_y = -7.0;  // tbd; placeholder - off-centre so the USB-C slot fits beside it
hardware_fastener_count = 6;  // settled; [adr] ADR 0009 - six M3 from the bottom into the plate
hardware_fastener_clear_d = 3.4;  // nominal; M3 clearance, medium fit [from memory]
hardware_fastener_head_d = 5.5;  // tbd; DIN 7984 M3 low-head cap screw, head diameter 5.5 [from memory]
hardware_fastener_head_h = 2.0;  // tbd; DIN 7984 M3 low-head cap screw, head height 2.0 [from memory] (ISO 4762 is 3.0, and would share the groove's depth)
hardware_fastener_cbore_d = 6.0;  // nominal; fastener_head_d plus clearance
hardware_fastener_cbore_depth = 2.5;  // nominal; fastener_head_h + 0.5 below flush. Must stay at or under the oak left under the side groove (oak bottom - stack.groove_depth), so the counterbore and the groove share no depth (drc 'fastener counterbores clear of the side grooves')
hardware_kb_stud_hole = 2.5;  // settled; the plate's hole for a PEM FHL-M2.5 stud, 2.5 +0.08, punched or drilled, NOT deburred [datasheets/mechanical/PEM-FH-SELF-CLINCHING-STUDS.pdf p.FH-7 table; installation, p.FH-18]
hardware_kb_stud_head_d = 3.15;  // settled; the FHL-M2.5 stud's head, H 3.15 +/-0.4, flush in the plate's top face [datasheets/mechanical/PEM-FH-SELF-CLINCHING-STUDS.pdf p.FH-7]
hardware_kb_stud_edge = 2.8;  // settled; the FHL-M2.5 stud's least distance from its hole's centre to the sheet's edge - or a switch cutout, which is an edge too [datasheets/mechanical/PEM-FH-SELF-CLINCHING-STUDS.pdf p.FH-7] (drc.echo 'key-board studs clear of the plate's edges and cutouts')
hardware_kb_stud_s = 2.1;  // settled; the FHL-M2.5 stud's unthreaded length S, max, from the head's face [datasheets/mechanical/PEM-FH-SELF-CLINCHING-STUDS.pdf p.FH-7]: the first 0.9 below a 1.2 plate is the clinch shank, inside the spacer; the thread starts inside it too
hardware_kb_stud_attached_hole = 2.9;  // settled; the largest hole PEM allows in the part that bears on the sheet round an FHL-M2.5 stud - here the spacer's bore [datasheets/mechanical/PEM-FH-SELF-CLINCHING-STUDS.pdf p.FH-7]
hardware_kb_stud_l = 10;  // nominal; the FHL-M2.5 stud's length code L, from the head's face (stocked 6, 8, 10, 12, 15, 18) [datasheets/mechanical/PEM-FH-SELF-CLINCHING-STUDS.pdf p.FH-7]: plate + spacer + key board + nut + two pitches, at the stud's shortest (kb_stud_l_tol), rounded up to a stocked length (drc.echo 'key-board stud: thread past the nut') [calc]
hardware_kb_stud_l_tol = [-0.4, 0.4];  // settled; the FHL stud's length tolerance, +/-0.4 [datasheets/mechanical/PEM-FH-SELF-CLINCHING-STUDS.pdf p.FH-7]
hardware_kb_stud_pitch = 0.45;  // settled; M2.5 coarse thread pitch [datasheets/mechanical/ASPEN-ISO4032-DIN934-HEX-NUT-DIMENSION-TABLE.pdf]
hardware_kb_stud_torque = 0.32;  // settled; the nut's recommended tightening torque on an FHL-M2.5 stud in 1.2 mm aluminium, N.m; PEM tested push-out 285 N, torque-out 0.55 N.m in that sheet (HRB 33) [datasheets/mechanical/PEM-FH-SELF-CLINCHING-STUDS.pdf p.FH-31, metric table]. FHL is rated for aluminium to HRB 80 / HB 150 [p.FH-7], which takes 5052 and 6061 alike
hardware_kb_plate_t_tol = [-0.05, 0.05];  // nominal; the key plate's thickness tolerance: the switch's own plate-slot tolerance (`plate-thickness`, config/figures.yaml), which a plate bought to that register must meet. It enters the key boards' depth because the spacer bears on the plate's underside while the stud's head is flush with its top
hardware_kb_board_hole = 2.7;  // nominal; M2.5 clearance through the key board, ISO 273 fine [from memory]: the board locates on the studs, so the fine fit
hardware_kb_spacer_l = 2.3;  // tbd; a plain metal spacer for M2.5 between the plate and the board, flat both ends, and the only thing there: the length that keeps the board at switch.pcb_below_seat [calc: 3.5 - 1.2]; its bore at most kb_stud_attached_hole. NOT STOCKED at 2.3 (Ettinger 5.52, Wurth WA-SMST and RAF step 2.0, 2.5/3.0): make it - face Ettinger 5.52.033 (M2.5, 3.0 long, bore 2.6, OD 4.5 [datasheets/mechanical/ETTINGER-CATALOG-2024-P79-DISTANZHUELSEN-MESSING.html]) down to 2.3 +/-0.05, in metal, not printed, which would creep under the nut's clamp
hardware_kb_spacer_l_tol = [-0.05, 0.05];  // tbd; the faced spacer's length tolerance, to be held when it is faced (kb_spacer_l)
hardware_kb_spacer_od = 4.5;  // nominal; the Ettinger 5.52 spacer's outside diameter, 4.5; its bore is 2.6, inside kb_stud_attached_hole [datasheets/mechanical/ETTINGER-CATALOG-2024-P79-DISTANZHUELSEN-MESSING.html]. It bears on the plate's underside and on the board's top copper, so the PCB keeps copper out from under it
hardware_kb_nut_e = 5.77;  // nominal; ISO 4032 M2.5 hex nut across its corners, at its largest: s max 5.0 / cos 30 = 5.77 [calc from datasheets/mechanical/ASPEN-ISO4032-DIN934-HEX-NUT-DIMENSION-TABLE.pdf, whose e is the minimum, 5.5]. It bears on the board's underside, so the PCB keeps copper and parts out from under it
