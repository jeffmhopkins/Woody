ECHO: "DRC", "PASS", "cap-to-cap gap, tightest pair", 1.5, "mm between adjacent MT165 caps; under ~1 mm a pad pressing one catches the next"
ECHO: "DRC", "PASS", "oak web between cap holes (slot)", "n/a - one slot per hand", "mm of oak between adjacent holes; under 2 mm, cross-grain, it will not survive - use slots"
ECHO: "DRC", "PASS", "key plate web between cutouts", 4, "mm of aluminium"
ECHO: "DRC", "PASS", "key plate web from a cutout to the plate edge", 6.3, "mm; the switch's latch arms need plate round them, and the plate edge sits in the side grooves' shadow"
ECHO: "DRC", "PASS", "oak between a cap slot and the body's long edge", 10.5, "mm of oak top outside the slot"
ECHO: "DRC", "INFO", "oak top thickness (flush at full travel)", 6, "mm = keycap_top_above_seat - total_travel; keycap height is tbd, so this is too"
ECHO: "DRC", "NOTE", "key cap stands proud of the top face at rest", 3, "mm = the travel"
ECHO: "DRC", "PASS", "cap hole clearance beats oak cross-grain movement across the hole", 0.75, "mm per side vs 0.27 mm of movement at 1.5 % (ADR 0009)"
ECHO: "DRC", "PASS", "keycap seats on its stem: the inside of its top above the stem's top", 1.4, "mm at rest - negative means the cap cannot sit at switch.keycap_top_above_seat on this stem"
ECHO: "DRC", "INFO", "keycap skirt at full travel", [2.5, 13.9], "mm above the seat, and the skirt's inside width there: over the housing (top at 3.35) its inside must clear the cover (13.75 across), and it must stay above the collar (0.45) - the clash check tests both on the trimmed mesh"
ECHO: "DRC", "PASS", "keycap skirt clears the switch's cover and collar at full travel", [-0.85, 0.15, 2.05], "mm: the pressed skirt above the housing's top; or the skirt's inside less the cover's width AND the skirt above the collar - the first, or both of the others, must be positive"
ECHO: "DRC", "PASS", "keycap skirt stays above the plate at full travel", 2.5, "mm above the seat (the plate's top face), fully pressed"
ECHO: "DRC", "NOTE", "inter-hand gap between caps", 33.5, "mm of clear band for the U-bolt and right thumb rest"
ECHO: "DRC", "PASS", "U-bolt legs clear of the thumb recesses", 14.5, "mm, worst case"
ECHO: "DRC", "PASS", "oak-bottom cuts at least 3 mm apart (thumb recesses, U-bolt)", [], "pairs closer than 3 mm, with the web between them (negative = overlap)"
