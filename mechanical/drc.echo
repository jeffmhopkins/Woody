ECHO: "DRC", "INFO", "layout", "PROVISIONAL", "0 of 18 keys placed in config/key-layout.yaml"
ECHO: "DRC", "INFO", "tbd parameters in play", 59, ["stack_cap_clear", "stack_cap_holes", "stack_side_inset", "stack_groove_depth", "stack_groove_clear", "ends_mouth_cap_t", "ends_tail_cap_t", "ends_tube_hole_d", "layout_mouth_extra", "layout_tail_clear", "layout_underside_clear", "layout_lh_offsets", "layout_rh_offsets", "layout_lt_arc_start", "layout_rt_rest_at", "layout_rt_offset", "switch_keycap_top_above_seat", "switch_cluster_pcb_w", "boards_display_recess", "boards_tall_l", "boards_tall_w", "boards_tall_h", "boards_stack_l", "boards_stack_w", "boards_disp_socket_h", "boards_carrier_l", "boards_carrier_w", "boards_matrix_harness_h", "boards_matrix_under_h", "boards_matrix_led_h", "openings_matrix_lip", "openings_matrix_acrylic_t", "openings_usb_slot_w", "openings_usb_slot_h", "openings_usb_plug_l", "openings_matrix_usb_to_tail", "openings_usb_ext_depth", "ethercon_socket_toward_centre", "ethercon_rj45_plug_l", "ethercon_rj45_plug_w", "ethercon_rj45_plug_h", "ethercon_rj45_drop", "ethercon_offset_y", "hardware_fastener_inset", "hardware_ubolt_rod_d", "hardware_ubolt_span", "hardware_ubolt_drop", "hardware_ubolt_nut_af", "hardware_ubolt_nut_h", "hardware_backplate_t", "routing_chain_stack", "routing_tube_od", "routing_trap_d", "routing_trap_l", "routing_tube_lane", "routing_lane_z", "lighting_strip_w", "lighting_strip_t", "lighting_strip_gap"]
ECHO: "DRC", "INFO", "overall length (derived)", 351.132, "mm = 13.8241 in; mouth cap to LH1 75.532, keys 184 centre to centre, last key to tail face 91.6"
ECHO: "DRC", "NOTE", "what the mouth end needs", "the display on the underside (it must clear the left-thumb recesses)", "display occupies X 14 to 72.782"
ECHO: "DRC", "NOTE", "what the tail end needs", "the LED matrix centred after the keys, with the etherCON behind it", "91.6 mm after the last key"
ECHO: "DRC", "INFO", "behind the Matrix, to the tail face", 28.8, "mm = USB-C plug 0 + clearance 3 + etherCON housing 19.8 + tail cap 6 - the rear socket and patch plug pass under the Matrix"
ECHO: "DRC", "PASS", "etherCON rear socket and patch plug pass under the Matrix", 0.95, "mm below the Matrix's underside parts"
ECHO: "DRC", "PASS", "body thickness takes the etherCON on the floor, its rear socket under the Matrix", 0.4, "mm spare; the thinnest body that does is 38.6 mm (envelope.thickness)"
ECHO: "DRC", "PASS", "LED matrix centred between the last cap and the tail face", 0, "mm off centre"
ECHO: "DRC", "PASS", "clear gap between the hands = clear gap from the last key to the matrix window", [33.5, 31.05], "mm cap edge to cap edge, and cap edge to window edge; 50 centre to centre (minimum 50)"
ECHO: "DRC", "FAIL", "LED strips at ADR 0014's length", 257.332, "mm per side against 420 in ADR 0014 - fewer LEDs per side if shorter"
ECHO: "DRC", "NOTE", "top key gaps along the body (LH then RH)", [[20, 20, 18, 0], [20, 20, 18, 0, 18]], "mm; runs 58 + 76; a 0 is a side-by-side pair"
ECHO: "DRC", "NOTE", "top key offsets across the body (LH then RH)", [[0, 0, 0, -9, 9], [0, 0, 0, -9, 9, -9]], "mm from the centreline, + toward the player's left"
ECHO: "DRC", "PASS", "cap-to-cap gap, tightest pair", 1.5, "mm between adjacent MT165 caps; under ~1 mm a pad pressing one catches the next"
ECHO: "DRC", "PASS", "oak web between cap holes (slot)", "n/a - one slot per hand", "mm of oak between adjacent holes; under 2 mm, cross-grain, it will not survive - use slots"
ECHO: "DRC", "PASS", "key plate web between cutouts", 4, "mm of aluminium"
ECHO: "DRC", "PASS", "key plate web from a cutout to the plate edge", 6.3, "mm; the switch's latch arms need plate round them, and the plate edge sits in the side grooves' shadow"
ECHO: "DRC", "PASS", "oak between a cap slot and the body's long edge", 10.5, "mm of oak top outside the slot"
ECHO: "DRC", "INFO", "oak top thickness (flush at full travel)", 6, "mm = keycap_top_above_seat - total_travel; keycap height is tbd, so this is too"
ECHO: "DRC", "NOTE", "key cap stands proud of the top face at rest", 3, "mm = the travel"
ECHO: "DRC", "PASS", "cap hole clearance beats oak cross-grain movement across the hole", 0.75, "mm per side vs 0.27 mm of movement at 1.5 % (ADR 0009)"
ECHO: "DRC", "NOTE", "inter-hand gap between caps", 33.5, "mm of clear band for the U-bolt and right thumb rest"
ECHO: "DRC", "PASS", "U-bolt legs clear of the thumb recesses", 4.25, "mm, worst case"
ECHO: "DRC", "FAIL", "oak-bottom cuts at least 3 mm apart (display, thumb recesses, spares, window, service, U-bolt, counterbores)", ["LT1 / LT2 0.5", "LT1 / spare 1 0.5", "LT2 / LT3 0.5", "LT2 / spare 1 0.5", "LT3 / LT4 0.5", "LT3 / spare 2 0.5", "LT4 / spare 2 0.5", "RT2 / spare 3 1.5", "RT3 / spare 3 1.5"], "pairs closer than 3 mm, with the web between them (negative = overlap)"
ECHO: "DRC", "FAIL", "oak-bottom cuts inside the U", 1.25, "mm, smallest web to the inside of a side"
ECHO: "DRC", "NOTE", "interior width between the acrylic sides", 45, "mm - was the full width less two sides; the oak lips now come off it too"
ECHO: "DRC", "PASS", "groove leaves at least half the oak under it", 3, "mm of oak under the groove in the thinner panel"
ECHO: "DRC", "PASS", "oak lip outside each groove", 2, "mm - thinner and it splits off along the grain"
ECHO: "DRC", "PASS", "cavity height", 25.8, "mm between the key plate and the oak bottom"
ECHO: "DRC", "NOTE", "top switch pole tip below the lid", 4.55, "mm into the cavity"
ECHO: "DRC", "PASS", "carrier clears the top cluster boards", 10.8, "mm between the carrier's top face and the cluster boards' underside, for components on both"
ECHO: "DRC", "NOTE", "display board height above the floor", 1.6, "mm it stands into the cavity (6.6 = the vendor STEP's full stack); keep the thumb plate and looms off it"
ECHO: "DRC", "INFO", "oak bottom thickness (thumb keys flush at full travel)", 6, "mm, the same rule as the oak top; thumb caps stand proud of the bottom face by the travel at rest"
ECHO: "DRC", "NOTE", "thumb switch pole tip height in the cavity", 11.75, "mm above the bottom face"
ECHO: "DRC", "FAIL", "carrier fits between the LED strips", -8, "mm spare across"
ECHO: "DRC", "PASS", "carrier under the lid", 14.6, "mm of component height above the carrier"
ECHO: "DRC", "PASS", "carrier clears the right-thumb switch bodies", 3.85, "mm"
ECHO: "DRC", "INFO", "carrier height (derived)", 15.6, "mm = just over the thumb boards' parts, with its own underside parts; it sits in the gap between the hands"
ECHO: "DRC", "PASS", "key plate web between the last key cutout and the matrix window", 32.3, "mm of aluminium"
ECHO: "DRC", "PASS", "oak lip under the frosted window", 3, "mm thick, 2 mm wide; the acrylic sits flush on it"
ECHO: "DRC", "PASS", "oak between the last cap slot and the window rebate", 28.3, "mm on the top face"
ECHO: "DRC", "NOTE", "LED tops to the frosted window's top face", 5, "mm - frosted acrylic this far above the LEDs softens the pixels; the owner chose it (2026-09-26)"
ECHO: "DRC", "PASS", "carrier clears the etherCON body", 100.3, "mm along X"
ECHO: "DRC", "PASS", "etherCON body inside the cavity height", [6.3, 32.3, 6, 33], "body Z range vs cavity Z range at the tail, where the key plate has ended"
ECHO: "DRC", "PASS", "key plate reaches past the last fastener pair", 19.25, "mm of plate beyond the tap hole; the plate stops short of the Matrix"
ECHO: "DRC", "PASS", "LED tops under the frosted window", 2, "mm, LED tops to the acrylic's underside - the board's top face is against the oak"
ECHO: "DRC", "PASS", "LED array fits the window opening it stands in", 1.2, "mm across, opening less the array"
ECHO: "DRC", "PASS", "etherCON flange fits behind the tail cap", 6.3, "mm, the smaller of above and below the flange, inside the cap's height"
ECHO: "DRC", "NOTE", "tail cap material below and above the etherCON bore", [7.3, 7.7], "mm - the connector stands on the floor, so it is not centred"
ECHO: "DRC", "PASS", "USB-C extension receptacle beside the etherCON body", 3.18, "mm spare across, inside the sides, for a 12.5 mm receptacle"
ECHO: "DRC", "FAIL", "tail cap web between the USB-C cutout and the etherCON flange", 1.5, "mm of oak on the tail face"
ECHO: "DRC", "INFO", "USB-C extension cable run, Matrix edge to receptacle", 19.5487, "mm straight line; buy the shortest extension that reaches, with slack for the tail cap to come off"
ECHO: "DRC", "NOTE", "M3 thread engagement in the key plate", 1.2, "mm of aluminium = ~2 threads at 0.5 pitch [calc]; plain tapping will strip, so the BOM's 'insert or tapped boss' is the only option"
ECHO: "DRC", "PASS", "fastener holes clear of the top switch cutouts", 8.05, "mm of plate between a tap hole and the nearest cutout"
ECHO: "DRC", "PASS", "fastener tap holes inside the plate edge", 1.55, "mm of plate outside the hole"
