ibbon_w", "routing_mcu_ribbon_t", "routing_chain_ribbon_t", "routing_chain_bend_r", "routing_chain_raise", "routing_chain_slack", "lighting_strip_w", "lighting_strip_t", "lighting_strip_per_m"]
ECHO: "DRC", "INFO", "overall length (derived)", 325.8, "mm = 12.8268 in; mouth cap to LH1 50, keys 184 centre to centre, last key to tail face 91.8"
ECHO: "DRC", "NOTE", "what the mouth end needs", "the breath trap before the first boards", "34.6 mm from the mouth cap to LH1"
ECHO: "DRC", "NOTE", "what the tail end needs", "the LED matrix centred after the keys, with the etherCON behind it", "91.8 mm after the last key"
ECHO: "DRC", "INFO", "behind the Matrix, to the tail face", 28.9, "mm = USB-C plug 0 + clearance 3 + the etherCON's adapter 1.6 + the connector to its flange 18.3 + tail cap 6 - J-UMB passes under the Matrix"
ECHO: "DRC", "PASS", "etherCON adapter behind the Matrix", 3, "mm from the Matrix's tail edge (and any plug off it) to the adapter's rear face; the adapter stands the connector's full height"
ECHO: "DRC", "PASS", "J-UMB passes under the Matrix", 15.6, "mm below the Matrix's underside parts"
ECHO: "DRC", "PASS", "body thickness takes the etherCON on the floor", 1.4, "mm spare; the thinnest body that does is 37.6 mm (envelope.thickness)"
ECHO: "DRC", "PASS", "LED matrix centred between the last cap and the tail face", 0, "mm off centre"
ECHO: "DRC", "PASS", "clear gap between the hands = clear gap from the last key to the matrix window", [33.5, 31.15], "mm cap edge to cap edge, and cap edge to window edge; 50 centre to centre (minimum 50)"
ECHO: "DRC", "NOTE", "LED strip on the main board (derived)", 220.25, "mm, one strip lighting both sides (ADR 0016) - 13 LEDs at 60/m"
ECHO: "DRC", "PASS", "breath tube crosses the strip clear of it", 4, "mm above the strip's top face"
ECHO: "DRC", "NOTE", "top key gaps along the body (LH then RH)", [[20, 20, 18, 0], [20, 20, 18, 0, 18]], "mm; runs 58 + 76; a 0 is a side-by-side pair"
