ECHO: "DRC", "INFO", "overall length (derived)", 331.1, "mm = 13.0354 in; mouth cap to LH1 50, keys 184.2 centre to centre, last key to tail face 96.9"
ECHO: "DRC", "NOTE", "what the mouth end needs", "the breath trap before the first boards", "34 mm from the mouth cap to LH1"
ECHO: "DRC", "NOTE", "what the tail end needs", "last key board, the last fastener pair, then the patch plug and the etherCON depth", "96.9 mm after the last key"
ECHO: "DRC", "INFO", "behind the Matrix, to the tail face", 28.8, "mm = USB-C plug 0 + clearance 3 + etherCON housing 19.8 + tail cap 6 - the rear socket and patch plug pass under the Matrix"
ECHO: "DRC", "PASS", "etherCON rear socket and patch plug pass under the Matrix", 0.95, "mm below the Matrix's underside parts"
ECHO: "DRC", "PASS", "body thickness takes the etherCON on the floor, its rear socket under the Matrix", 0.4, "mm spare; the thinnest body that does is 38.6 mm (envelope.thickness)"
ECHO: "DRC", "PASS", "LED matrix centred between the last cap and the tail face", 0, "mm off centre"
ECHO: "DRC", "PASS", "clear gap between the hands = clear gap from the last key to the matrix window", [33.7, 33.7], "mm cap edge to cap edge, and cap edge to window edge; 50.2 centre to centre (minimum 50)"
