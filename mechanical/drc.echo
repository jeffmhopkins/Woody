ECHO: "DRC", "INFO", "layout", "PROVISIONAL", "0 of 19 keys placed in config/key-layout.yaml"
ECHO: "DRC", "INFO", "tbd parameters in play", 56, ["stack_cap_clear", "stack_cap_holes", "stack_side_inset", "stack_groove_depth", "stack_groove_clear", "ends_mouth_cap_t", "ends_tail_cap_t", "ends_tube_hole_d", "layout_mouth_extra", "layout_tail_clear", "layout_underside_clear", "layout_lh_offsets", "layout_rh_offsets", "layout_lt_rest_under", "layout_lt_rest", "layout_rt_rest_under", "layout_rt_rest", "switch_keycap_top_above_seat", "switch_cluster_pcb_w", "boards_tall_l", "boards_tall_w", "boards_tall_h", "boards_conn_l", "boards_conn_w", "boards_board_clear", "boards_standoff_d", "boards_matrix_harness_h", "boards_matrix_under_h", "boards_matrix_led_h", "openings_matrix_lip", "openings_matrix_acrylic_t", "openings_usb_slot_w", "openings_usb_slot_h", "openings_usb_plug_l", "openings_matrix_usb_to_tail", "openings_usb_ext_depth", "ethercon_socket_toward_centre", "ethercon_rj45_plug_l", "ethercon_rj45_plug_w", "ethercon_rj45_plug_h", "ethercon_offset_y", "hardware_fastener_inset", "hardware_ubolt_rod_d", "hardware_ubolt_span", "hardware_ubolt_drop", "hardware_ubolt_nut_af", "hardware_ubolt_nut_h", "hardware_backplate_t", "routing_tube_od", "routing_trap_d", "routing_trap_l", "routing_tube_lane", "routing_lane_z", "lighting_strip_w", "lighting_strip_t", "lighting_strip_per_m"]
ECHO: "DRC", "INFO", "overall length (derived)", 325.6, "mm = 12.8189 in; mouth cap to LH1 50, keys 184 centre to centre, last key to tail face 91.6"
ECHO: "DRC", "NOTE", "what the mouth end needs", "the breath trap before the first boards", "30 mm from the mouth cap to LH1"
ECHO: "DRC", "NOTE", "what the tail end needs", "the LED matrix centred after the keys, with the etherCON behind it", "91.6 mm after the last key"
ECHO: "DRC", "INFO", "behind the Matrix, to the tail face", 28.8, "mm = USB-C plug 0 + clearance 3 + etherCON housing 19.8 + tail cap 6 - the rear socket and patch plug pass under the Matrix"
ECHO: "DRC", "PASS", "etherCON rear socket and patch plug pass under the Matrix", 0.95, "mm below the Matrix's underside parts"
ECHO: "DRC", "PASS", "body thickness takes the etherCON on the floor, its rear socket under the Matrix", 0.4, "mm spare; the thinnest body that does is 38.6 mm (envelope.thickness)"
ECHO: "DRC", "PASS", "LED matrix centred between the last cap and the tail face", 0, "mm off centre"
ECHO: "DRC", "PASS", "clear gap between the hands = clear gap from the last key to the matrix window", [33.5, 31.05], "mm cap edge to cap edge, and cap edge to window edge; 50 centre to centre (minimum 50)"
ECHO: "DRC", "NOTE", "LED strip on the main board (derived)", 225.25, "mm, one strip lighting both sides (ADR 0016) - 13 LEDs at 60/m"
ECHO: "DRC", "PASS", "breath tube crosses the strip clear of it", 4, "mm above the strip's top face"
ECHO: "DRC", "NOTE", "top key gaps along the body (LH then RH)", [[20, 20, 18, 0], [20, 20, 18, 0, 18]], "mm; runs 58 + 76; a 0 is a side-by-side pair"
ECHO: "DRC", "NOTE", "top key offsets across the body (LH then RH)", [[0, 0, 0, -9, 9], [0, 0, 0, -9, 9, -9]], "mm from the centreline, + toward the player's left"
ECHO: "DRC", "PASS", "cap-to-cap gap, tightest pair", 1.5, "mm between adjacent MT165 caps; under ~1 mm a pad pressing one catches the next"
ECHO: "DRC", "PASS", "oak web between cap holes (slot)", "n/a - one slot per hand", "mm of oak between adjacent holes; under 2 mm, cross-grain, it will not survive - use slots"
ECHO: "DRC", "PASS", "key plate web between cutouts", 4, "mm of aluminium"
ECHO: "DRC", "PASS", "key plate web from a cutout to the plate edge", 6.3, "mm; the switch's latch arms need plate round them, and the plate edge sits in the side grooves' shadow"
ECHO: "DRC", "PASS", "oak between a cap slot and the body's long edge", 10.5, "mm of oak top outside the slot"
ECHO: "DRC", "INFO", "oak top thickness (flush at full travel)", 6, "mm = keycap_top_above_seat - total_travel; keycap height is tbd, so this is too"
ECHO: "DRC", "NOTE", "key cap stands proud of the top face at rest", 3, "mm = the travel"
ECHO: "DRC", "PASS", "cap hole clearance beats oak cross-grain movement across the hole", 0.75, "mm per side vs 0.27 mm of movement at 1.5 % (ADR 0009)"
ECHO: "DRC", "NOTE", "inter-hand gap between caps", 33.5, "mm of clear band for the U-bolt and right thumb rest"
ECHO: "DRC", "PASS", "U-bolt legs clear of the thumb recesses", 13.5, "mm, worst case"
ECHO: "DRC", "PASS", "oak-bottom cuts at least 3 mm apart (thumb recesses, U-bolt, counterbores)", [], "pairs closer than 3 mm, with the web between them (negative = overlap)"
ECHO: "DRC", "FAIL", "oak-bottom cuts inside the U", 1.3, "mm, smallest web to the inside of a side"
ECHO: "DRC", "NOTE", "interior width between the acrylic sides", 45, "mm - was the full width less two sides; the oak lips now come off it too"
ECHO: "DRC", "PASS", "groove leaves at least half the oak under it", 3, "mm of oak under the groove in the thinner panel"
ECHO: "DRC", "PASS", "oak lip outside each groove", 2, "mm - thinner and it splits off along the grain"
ECHO: "DRC", "PASS", "cavity height", 25.8, "mm between the key plate and the oak bottom"
ECHO: "DRC", "NOTE", "top switch pole tip below the lid", 4.55, "mm into the cavity"
ECHO: "DRC", "INFO", "oak bottom thickness (thumb keys flush at full travel)", 6, "mm, the same rule as the oak top; thumb caps stand proud of the bottom face by the travel at rest"
ECHO: "DRC", "NOTE", "thumb switch pole tip height in the cavity", 11.75, "mm above the bottom face"
ECHO: "DRC", "NOTE", "main board (derived)", [239.5, 42], "mm long x wide, underside at 9.4 mm - mouth cap to the end of the right hand, the full width inside the sides"
ECHO: "DRC", "PASS", "main board parts room under the key boards", 13.7, "mm from its top face to the key boards' parts, less the clearances - every part there must fit this"
ECHO: "DRC", "NOTE", "main board parts room where no key board is overhead", 19.3, "mm, up to the plate"
ECHO: "DRC", "PASS", "breath sensor fits at the mouth end", 9.4, "mm spare above it"
ECHO: "DRC", "PASS", "main board standoffs found clear of everything", 6, "standoffs off the oak; the soldered thumb switches carry the board between them"
ECHO: "DRC", "PASS", "regulator block fits where it stands", 6.8, "mm spare, beside the key boards, clear to the lid [approx: key board footprints as squares; clash.txt is the check] - negative means low-profile parts"
ECHO: "DRC", "PASS", "stacking header right_thumb to right_hand clear of both boards' switches", 178, "mm along the body, midway between two thumb keys"
ECHO: "DRC", "PASS", "stacking header left_thumb to left_hand clear of both boards' switches", 70, "mm along the body, midway between two thumb keys"
ECHO: "DRC", "PASS", "key plate beyond the last key cutout", 29.8, "mm of aluminium; the plate stops short of the Matrix"
