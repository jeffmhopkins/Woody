ECHO: "DRC", "INFO", "layout", "PROVISIONAL", "0 of 18 keys placed in config/key-layout.yaml"
ECHO: "DRC", "INFO", "tbd parameters in play", 31, ["stack_cap_clear", "stack_cap_holes", "stack_side_inset", "stack_groove_depth", "stack_groove_clear", "ends_mouth_cap_t", "ends_tail_cap_t", "ends_tube_hole_d", "layout_slack_to", "layout_lt_arc_start", "layout_rt_rest_at", "layout_rt_offset", "switch_keycap_top_above_seat", "switch_cluster_pcb_w", "boards_display_recess", "boards_carrier_l", "boards_carrier_w", "boards_carrier_z", "boards_carrier_from_tail", "openings_usb_slot_w", "openings_usb_slot_h", "ethercon_body_d", "ethercon_offset_y", "hardware_fastener_inset", "hardware_fastener_end", "hardware_ubolt_rod_d", "hardware_ubolt_span", "hardware_ubolt_drop", "hardware_backplate_t", "lighting_strip_w", "lighting_strip_gap"]
ECHO: "DRC", "PASS", "length budget closes (ADR 0009 table)", 77, "mm of slack, assigned to 'tail'"
ECHO: "DRC", "NOTE", "top key gaps, centre to centre (LH then RH)", [[20, 20, 18, 18], [20, 20, 18, 18, 18]], "mm; runs 76 + 94"
ECHO: "DRC", "PASS", "cap-to-cap gap, tightest pair", 1.5, "mm between adjacent MT165 caps; under ~1 mm a pad pressing one catches the next"
ECHO: "DRC", "PASS", "oak web between cap holes (slot)", "n/a - one slot per hand", "mm of oak between adjacent holes; under 2 mm, cross-grain, it will not survive - use slots"
ECHO: "DRC", "PASS", "key plate web between cutouts", 4, "mm of aluminium"
ECHO: "DRC", "INFO", "oak top thickness (flush at full travel)", 6, "mm = keycap_top_above_seat - total_travel; keycap height is tbd, so this is too"
ECHO: "DRC", "NOTE", "key cap stands proud of the top face at rest", 3, "mm = the travel"
ECHO: "DRC", "PASS", "cap hole clearance beats oak cross-grain movement across the hole", 0.75, "mm per side vs 0.27 mm of movement at 1.5 % (ADR 0009)"
ECHO: "DRC", "NOTE", "inter-hand gap between caps", 33.5, "mm of clear band for the U-bolt and right thumb rest"
ECHO: "DRC", "PASS", "U-bolt legs clear of the thumb recesses", 8.58462, "mm, worst case"
ECHO: "DRC", "FAIL", "oak-bottom cuts at least 3 mm apart (display, thumb recesses, spares, window, service, U-bolt, counterbores)", ["LT1 / LT2 0.5", "LT1 / spare 1 0.5", "LT1 / display 0.859", "LT2 / LT3 0.5", "LT3 / LT4 0.5", "LT4 / spare 2 0.5", "LT4 / M3 #3 -0.45", "RT2 / spare 3 1.5", "RT3 / spare 3 1.5", "RT3 / M3 #4 -2.95", "spare 1 / display -12.4975", "spare 2 / U-bolt -1.75", "spare 2 / M3 #3 -5.05", "spare 3 / U-bolt 2.15", "service opening / M3 #5 -1.5", "display / M3 #2 -0.7475"], "pairs closer than 3 mm, with the web between them (negative = overlap)"
ECHO: "DRC", "FAIL", "oak-bottom cuts inside the U", 1.25, "mm, smallest web to the inside of a side"
ECHO: "DRC", "NOTE", "interior width between the acrylic sides", 45, "mm - was the full width less two sides; the oak lips now come off it too"
ECHO: "DRC", "PASS", "groove leaves at least half the oak under it", 3, "mm of oak under the groove in the thinner panel"
ECHO: "DRC", "PASS", "oak lip outside each groove", 2, "mm - thinner and it splits off along the grain"
ECHO: "DRC", "PASS", "cavity height", 24.8, "mm between the key plate and the oak bottom"
ECHO: "DRC", "NOTE", "top switch pole tip below the lid", 4.55, "mm into the cavity"
ECHO: "DRC", "PASS", "carrier clears the top cluster boards", 5.4, "mm between the carrier's top face and the cluster boards' underside, for components on both"
ECHO: "DRC", "NOTE", "display board height above the floor", 1.6, "mm it stands into the cavity (6.6 = the vendor STEP's full stack); keep the thumb plate and looms off it"
ECHO: "DRC", "INFO", "oak bottom thickness (thumb keys flush at full travel)", 6, "mm, the same rule as the oak top; thumb caps stand proud of the bottom face by the travel at rest"
ECHO: "DRC", "NOTE", "thumb switch pole tip height in the cavity", 11.75, "mm above the bottom face"
ECHO: "DRC", "FAIL", "carrier fits between the LED strips", -8, "mm spare across"
ECHO: "DRC", "PASS", "carrier under the lid", 9.2, "mm of component height above the carrier"
ECHO: "DRC", "PASS", "carrier clears the right-thumb switch bodies", 8.25, "mm"
ECHO: "DRC", "PASS", "carrier clears the etherCON body", 13.45, "mm along X"
ECHO: "DRC", "FAIL", "etherCON body inside the cavity height", [7, 31, 6, 30.8], "body Z range vs cavity Z range; outside = through-cuts in the oak at the tail"
ECHO: "DRC", "FAIL", "etherCON panel stack within the connector's maximum", 9, "mm (tail cap + backplate) vs 4 max for the NE8FDP"
ECHO: "DRC", "PASS", "etherCON flange margin on the tail face", 6, "mm above and below (ADR 0009: 6.00 rotated)"
ECHO: "DRC", "FAIL", "Matrix USB-C at the tail face (ADR 0009: 'Keep that edge of the board at the tail')", 44, "mm from the board edge to the tail cap; more than a few = a panel-mount USB-C extension"
ECHO: "DRC", "FAIL", "room beside the etherCON body for the Matrix board at the tail", 19.5, "mm across, vs 25 board"
ECHO: "DRC", "NOTE", "M3 thread engagement in the key plate", 1.2, "mm of aluminium = ~2 threads at 0.5 pitch [calc]; plain tapping will strip, so the BOM's 'insert or tapped boss' is the only option"
ECHO: "DRC", "PASS", "fasteners clear of the top switch cutouts", 15.5631, "mm, centre to nearest key centre"
