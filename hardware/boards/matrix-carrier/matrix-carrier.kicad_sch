    (property "Pins_source" "datasheets/mechanical/WAVESHARE-ESP32-S3-MATRIX-pinout.png (top view): 5V, GND, 3V3(OUT), 7, 6, 5, 4, 3, 2, 1 from the USB-C edge" (at 330.20 121.92 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "The Matrix's 5V..IO1 pad row: a 1x10 surface-mount header standing on the carrier's top face, its staggered feet soldered there (nothing comes through: J-MCU-C's insulator is under it) and its posts through the Matrix's pads, the Matrix sitting on its 2.5 mm plastic (config/body.yaml boards.matrix_hdr_h); the posts cut flush on the Matrix's top face. IO6 is the MIDI out's tip line (issue #37), to J-MCU-C pin 2 (J-MCU 23); IO2, its ring line, was already routed. IO4 and IO5 reach nothing (spare, carrier.md) and are soldered for strength." (at 330.20 121.92 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "hanxia" (at 330.20 121.92 0) (effects (font (size 1.27 1.27)) hide))
