    (property "Note" "The summer's output inside its loop, ahead of R-OUT-PROT: the breath LED's driver reads it (#32)" (at 269.24 71.12 0) (effects (font (size 1.27 1.27)) hide)))
  (text "THIS CIRCUIT IS ON BOTH MODULE BOARDS (ADR 0023). Page main holds its main-board parts, page jack the parts behind the panel; the labels here join the two pages, and on the boards J-B2B-MOD joins them. Each board places its own page." (at 60.96 30.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 4d849af9-c020-5174-9bc7-9a469563f3e0))
