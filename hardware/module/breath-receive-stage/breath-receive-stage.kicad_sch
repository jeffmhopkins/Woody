    (property "Manufacturer" "YAGEO" (at 294.64 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "CC0805FRNPO9BN680" (at 294.64 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "C541517" (at 294.64 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "hand" (at 294.64 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "A MATCHED PAIR with its twin (owner, 2026-10-03: 'Tighten cap matching'; 68 pF since #32): C-CM-IN+ and C-CM-IN- from one reel of the 1 % C0G part, measured on one LCR meter (open-circuit compensated, at 100 kHz if it has it) and fitted together only when each is within 0.5 % of the pair's mean. Their mismatch converts the umbilical's common mode in proportion to frequency, so it sets each bandwidth mode's CMRR at its top (module/breath-receive-stage/sim cmrr-*). The 1 % C0G is the tightest catalogued, so the match is made by hand: fitted by hand, after measuring. Fixed in every mode of the bandwidth toggle" (at 294.64 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid fa984e09-0745-5126-9cac-9fa5646a09dd))
    (pin "2" (uuid eae23104-4541-5c57-a818-4e7e6f3f106e))
