  (symbol (lib_id "woody:SW_NKK_M2024_wired") (at 279.4 76.2 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid c50af805-d255-5684-8101-f7bdd71d8f0f)
    (property "Reference" "SW-BREATH-BW" (at 279.4 68.58 0) (effects (font (size 1.27 1.27))))
    (property "Value" "NKK M2024SD4G01" (at 279.4 71.12 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Connector_Wire:SolderWire-0.25sqmm_1x03_P4.2mm_D0.65mm_OD1.7mm" (at 279.4 82.55 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "SW-BREATH-BW" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "COM=1 L4=2 L1=3" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "THE BREATH BANDWIDTH TOGGLE (owner, 2026-10-04: 'Panel 3-way toggle', '500 Hz / 1.5 kHz / wide'; thrown left-right like SW-POWER: 'full left being 500 full right being wide is the intuitive placement because it matches the on off of the power switch'). MOUNTED AS SW-POWER IS, D-flat on the LEFT, so lever RIGHT = NKK Down, lever LEFT = NKK Up (SW-POWER's own row and NKK p.5). Lug 1 is made only at Up (lever LEFT) and lug 4 at Up and Center, so: LEFT = 500 Hz (BW0 and BW1), CENTRE = 1.5 kHz (BW1), RIGHT = WIDE (neither: Down makes 2-3 and 5-6, and lugs 3 and 6 are not wired). A thermometer code from one ON-ON-ON part; it carries DC only, the analog pair never leaves this board. Panel-mounted like SW-POWER, its lugs wired to this board beside U-BW-SW. CONTACT MATERIAL G, GOLD: about 0.8 mA per line, above the gold contacts' 0.1 mA minimum. Buzz it on arrival: lever left, pad 1 to pads 2 and 3" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/connectors/NKK-SERIES-M-TOGGLE.pdf p.5, the 3-throw (3-on) table, M2024 on a double-pole base: Down makes 2-3 and 5-6, Center 2-3 and 5-4, Up 2-1 and 5-4. Panel-mounted and wired: pad 1 takes the commons (lugs 2 and 5, jumpered at the switch), pad 2 lug 4, pad 3 lug 1; lugs 3 and 6 are not wired" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "NKK Switches" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "M2024SD4G01" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "hand" (at 279.4 76.2 0) (effects (font (size 1.27 1.27)) hide))
