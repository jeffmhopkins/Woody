    (property "Pins" "SEL1=1 D1=2 S1=3 VSS=4 GND=5 S4=6 D4=7 SEL4=8 SEL3=9 D3=10 S3=11 VDD=13 S2=14 D2=15 SEL2=16" (at 170.18 81.28 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "Switches C-DIFF-BW-1K5 (channels 1 and 2, SEL1 = SEL2 = BW1) and C-DIFF-BW-500 (channels 3 and 4, SEL3 = SEL4 = BW0) across the in-amp's input pair, EACH CAPACITOR AT BOTH ENDS: every D pin is on IN_POS or IN_NEG, one of each pair per leg, so the switch's own pin capacitance is the same common-mode load on both legs. Lay the two legs out as mirror images. Closes on logic 1" (at 170.18 81.28 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/analog/TMUX6112-ti-scds383f.pdf p.4, Table 5-1 (PW, TSSOP-16): SEL1 1, D1 2, S1 3, VSS 4, GND 5, S4 6, D4 7, SEL4 8, SEL3 9, D3 10, S3 11, NC 12, VDD 13, S2 14, D2 15, SEL2 16. Pin 12 is no internal connection and is on no net" (at 170.18 81.28 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "Texas Instruments" (at 170.18 81.28 0) (effects (font (size 1.27 1.27)) hide))
