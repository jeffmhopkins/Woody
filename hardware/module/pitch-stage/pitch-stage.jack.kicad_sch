    (property "Reference" "D-ESD-PITCH" (at 58.42 57.15 270) (effects (font (size 1.27 1.27)) (justify right)))
    (property "Value" "PESD15VL1BA" (at 58.42 59.69 270) (effects (font (size 1.27 1.27)) (justify right)))
    (property "Footprint" "Diode_SMD:D_SOD-323" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "D-ESD-PITCH" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "K1=1(A1) K2=2(A2)" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "JACK-SIDE ESD CLAMP for the LT5400 (owner, 2026-10-01). Bidirectional, tip to sleeve, AT THE JACK on this board, so a strike on the tip is clamped before it crosses J-B2B-MOD and reaches TRIM-GAIN and RN-PITCH, which has no internal ESD diodes (LT5400.pdf p.6; its Figure 1 second option, a bidirectional zener to ground at the connector). On the DC feedback node, so its leakage and capacitance sit inside the loop: no accuracy cost (pitch-stage.md, The jack-side ESD clamp)" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/discrete-and-power/NEXPERIA-PESD15VL1BA.pdf Table 2 pinning: 1 K1 cathode (diode 1), 2 K2 cathode (diode 2); bidirectional and symmetric, so either way round" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "Nexperia" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "PESD15VL1BA,115" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "C85378" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "machine" (at 55.88 58.42 0) (effects (font (size 1.27 1.27)) hide))
