    (in_bom yes) (on_board yes) (dnp no)
    (uuid 98b1955f-1e62-5d25-9335-b08238dff07c)
    (property "Reference" "U-RX-MOD" (at 142.24 231.14 0) (effects (font (size 1.27 1.27))))
    (property "Value" "74AHCT14" (at 142.24 233.68 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm" (at 142.24 238.76 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 142.24 238.76 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "U-RX-MOD" (at 142.24 238.76 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "1A=1 1Y=2 2A=3 2Y=4 3A=5 3Y=6 4A=9 4Y=8 5A=11 5Y=10 6A=13 6Y=12 VCC=14 GND=7" (at 142.24 238.76 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "THE MODULE'S SPI RECEIVER (owner, 2026-09-30: add a buffer with hysteresis at the receiving end). Each signal passes two gates, so it arrives at U-LVL-MOD uninverted: SCLK gates 1-2, MOSI 3-4, CS_MOD 5-6, every gate used. Its first gate is the only Schmitt input on the link, behind R-RX-MOD and C-RX-MOD; TTL-compatible thresholds with 0.4 V minimum hysteresis [SN74AHCT14.pdf p.5]. Like the 74AHCT125 it has NO INPUT CLAMP TO VCC (I_IK specified for VI < 0 only, p.4; I_I +/-1 uA at VCC = 0 V, p.5), so a powered instrument back-driving an unpowered module is still safe. interfaces/spi-link/sim, spi-pair-crosstalk" (at 142.24 238.76 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/logic/SN74AHCT14.pdf p.3 pin-out (SOIC-14): 1A 1, 1Y 2, 2A 3, 2Y 4, 3A 5, 3Y 6, GND 7, 4Y 8, 4A 9, 5Y 10, 5A 11, 6Y 12, 6A 13, VCC 14. Drawn with KiCad's 74HC14 symbol: the same pinout" (at 142.24 238.76 0) (effects (font (size 1.27 1.27)) hide))
