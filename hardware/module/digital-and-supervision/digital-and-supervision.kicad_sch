    (property "Pins" "1=1 2=2" (at 193.04 142.24 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "PULL-UP TO LOGIC_5V, 100k - the weak half of CS_MOD's two pulls (the strong one is R-CS-PULL-INST, 10k to 3V3 at the instrument). Weak so that with the instrument plugged in and unpowered it drives only ~45 uA into the dead 3V3 rail and the node sits at ~0.45 V, not the 430 uA a 10k here would force through the ESP32's clamp; with nothing plugged in it holds the buffer input, and so SYNC, deselected. interfaces/spi-link/spi-link.md, 'CS_MOD's two pulls'" (at 193.04 142.24 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "UNI-ROYAL(Uniroyal Elec)" (at 193.04 142.24 0) (effects (font (size 1.27 1.27)) hide))
