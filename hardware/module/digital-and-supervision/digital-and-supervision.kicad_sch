    (uuid ff6b33fb-f93a-5d86-b50e-59393d13fc94)
    (property "Reference" "U-LVL-MOD" (at 40.64 43.18 0) (effects (font (size 1.27 1.27))))
    (property "Value" "74AHCT125" (at 40.64 45.72 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "U-LVL-MOD" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "1A=2 1Y=3 1OE=1 2A=5 2Y=6 2OE=4 3A=9 3Y=8 3OE=10 4A=12 4Y=11 4OE=13 VCC=14 GND=7" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "VCC IS DAC_AVDD, NOT LOGIC_5V, AND MUST STAY THAT WAY (owner, 2026-10-01, option 1): its outputs are the DAC8568's SYNC, SCLK and DIN, whose absolute maximum is AVDD + 0.3 V and which must never be high before the DAC has its supply [DAC8568CIPW.pdf p.2, p.31]; on the DAC's own rail they cannot be, on or off. Its inputs come from U-RX-MOD on LOGIC_5V, which arrives first and leaves last: they take that 5 V high with VCC low because there is NO INPUT CLAMP TO VCC (VI -0.5 to 7 V not referenced to VCC, I_IK for VI < 0 only, I_I +/-1 uA at VI = 5.5 V for VCC 0 to 5.5 V [SN74AHCT125.pdf p.3-4]) - the same property that makes back-driving an unpowered module safe. OE IS TIED ENABLED AND MUST STAY THAT WAY - the presence comparator that gated it is deleted. Inputs are TTL thresholds, V_IH 2.0V min, not ratioed to VCC. digital-and-supervision/sim, rails-and-sync" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/logic/SN74AHCT125.pdf p.1 pin-out (SOIC-14): 1OE 1, 1A 2, 1Y 3, 2OE 4, 2A 5, 2Y 6, GND 7, 3Y 8, 3A 9, 3OE 10, 4Y 11, 4A 12, 4OE 13, VCC 14" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "Texas Instruments" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "SN74AHCT125DR" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "C155176" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "machine" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
