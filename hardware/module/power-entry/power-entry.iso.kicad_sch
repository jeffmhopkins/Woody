    (property "Value" "1mH" (at 297.18 375.91999999999996 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "woody:L_CommonModeChoke_Bourns_PM3700" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "L-CM-ISO" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "IN_POS=1(1) OUT_POS=2(2) OUT_NEG=3(3) IN_NEG=4(4)" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/discrete-and-power/BOURNS-PM3700-CM-CHOKE.pdf p.1 Schematic: one winding 1-2, the other 4-3, polarity dots on 1 and 4. The symbol's 1243 variant draws the same windings with its dots on 1 and 4, so symbol pin n is the part's pin n. +12 V leg in on 1 out on 2; -12 V leg in on 4 out on 3: the supply and its return cancel, a common-mode current aids" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "U-ISO's input common-mode choke (owner, 2026-10-01; ADR 0027): between the input filter (L-ISO-IN, FB4) and the converter's pins, so the 550 kHz current through U-ISO's isolation capacitance goes home through C-ISO-Y and not round NT-UMB-MOD, the star, AGND_MOD and the -12 V entry. Its leakage, 3.9 uH typ, adds to L-ISO-IN in the differential filter (power-entry.md)" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "Bourns" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
