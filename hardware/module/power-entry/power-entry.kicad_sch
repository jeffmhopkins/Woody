    (uuid d0507312-8335-5634-b9dd-16ad7c54b901)
    (property "Reference" "J-PWR-EURO" (at 41.91 50.8 0) (effects (font (size 1.27 1.27))))
    (property "Value" "2x8 2.54mm shrouded box header (16-pin)" (at 41.91 73.66 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Connector_IDC:IDC-Header_2x08_P2.54mm_Vertical" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "J-PWR-EURO" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "NEG12_1=1 NEG12_2=2 GND_3=3 GND_4=4 GND_5=5 GND_6=6 GND_7=7 GND_8=8 POS12_9=9 POS12_10=10 POS5_11=11 POS5_12=12 CV_13=13 CV_14=14 GATE_15=15 GATE_16=16" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "Keyed, but a key does not make a reversed ribbon impossible. The rack's -12 V is the pin-1 pair, the ribbon's red stripe, and reversing it is what D-REVPOL exists for. The bus +5 V (11, 12) and CV/Gate (13-16) pins are NOT USED: pads present, no-connect - the module makes its own 5 V (U-REG-LOGIC), and the header stays 2x8 for commonality with every Eurorack power cable (owner, 2026-09-30)" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/mechanical/DOEPFER-A100-BUS-CONNECTORS-a100b_e.gif: -12V on the pin-1 pair (red stripe), GND 3-8, +12V 9-10, +5V 11-12, CV 13-14, Gate 15-16; odd/even across the rows as a 2x8 IDC header numbers them" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "XFCN" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "BH254V-16P" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "C492443" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "hand" (at 40.64 60.96 0) (effects (font (size 1.27 1.27)) hide))
