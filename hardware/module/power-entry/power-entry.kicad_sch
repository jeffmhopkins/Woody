    (property "Value" "LT3042EMSE" (at 231.14 200.66 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Package_SO:MSOP-10-1EP_3x3mm_P0.5mm_EP1.68x1.88mm" (at 243.84 180.34 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 243.84 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "U-REG-DAC" (at 243.84 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "IN=1(IN) IN_2=2(IN) EN=3(EN/UV) PG=4(PG) ILIM=5(ILIM) PGFB=6(PGFB) SET=7(SET) GND=8(GND) OUTS=9(OUTS) OUT=10(OUT) EP=11(GND)" (at 243.84 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/discrete-and-power/ADI-LT3042.pdf p.2, MSE package: 1-2 IN, 3 EN/UV, 4 PG, 5 ILIM, 6 PGFB, 7 SET, 8 GND, 9 OUTS, 10 OUT, 11 exposed pad = GND, must be soldered. The symbol is KiCad's LT3042xMSE with the same numbers" (at 243.84 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "DAC_AVDD = I_SET x R-SET-DAC, no adjustment (owner, 2026-10-01). EN/UV and PGFB tied to IN: always on, fast start-up and power-good off, so the 2 mA start-up current can never be left on (p.12, p.18). PG open. ILIM to GND: the internal limit. OUTS Kelvin to C-REG-OUT; R-SET-DAC's and C-SET-DAC's ground returns to C-REG-OUT's ground; guard ring round SET at OUT's potential (p.14-15). Exposed pad soldered to AGND_MOD copper" (at 243.84 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "Analog Devices" (at 243.84 187.96 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "LT3042EMSE#TRPBF" (at 243.84 187.96 0) (effects (font (size 1.27 1.27)) hide))
