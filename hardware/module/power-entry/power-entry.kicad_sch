  (hierarchical_label "DIG_GND" (shape passive) (at 248.92 370.84 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid b9834f76-b1f1-4164-9661-5f9a56ff76e0)
    (property "Dir" "ref" (at 248.92 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "To" "module/digital-and-supervision" (at 248.92 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Figure" "dig-gnd-topology" (at 248.92 370.84 0) (effects (font (size 1.27 1.27)) hide)))
  (text "ADDED 2026-09-30 (ADR 0027): the rail fuses (PTC-POS12, PTC-NEG12), the instrument's isolated supply - PTC-\nISO, D2, FB2, L-ISO-IN on the +12 leg, D4, FB4 on the -12 leg, C2 and C-ISO-IN across, U-ISO, C-ISO-OUT,\nC-ISO-Y - and NT-UMB-MOD. BUS_GND is the Eurorack ground as it arrives, the star: AGND_MOD (NT-AGND-MOD) and\nDIG_GND (NT-DIG-MOD) meet it, and PWR_GND - U-ISO's isolated return - meets DIG_GND at the etherCON (NT-UMB-\nMOD) and nothing else. So no DC current of the instrument's reaches BUS_GND, the ribbon or the rack. power-\nentry.md" (at 40.64 393.7 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 1eb0ce46-dc74-42cb-b3d0-e438e7acfbe6))
  (symbol (lib_id "Filter:Choke_CommonMode_FerriteCore_1243") (at 294.64 370.84 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid fb5673b9-f161-46d4-b301-6140077d44ce)
    (property "Reference" "L-CM-ISO" (at 297.18 365.76 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "1mH" (at 297.18 375.91999999999996 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "woody:L_CommonModeChoke_Bourns_PM3700" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "L-CM-ISO" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "IN_POS=1(1) OUT_POS=2(2) OUT_NEG=3(3) IN_NEG=4(4)" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/discrete-and-power/BOURNS-PM3700-CM-CHOKE.pdf p.1 Schematic: one winding 1-2, the other 4-3, polarity dots on 1 and 4. The symbol's 1243 variant draws the same windings with its dots on 1 and 4, so symbol pin n is the part's pin n. +12 V leg in on 1 out on 2; -12 V leg in on 4 out on 3: the supply and its return cancel, a common-mode current aids" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "U-ISO's input common-mode choke (owner, 2026-10-01; ADR 0027): between the input filter (L-ISO-IN, FB4) and the converter's pins, so the 550 kHz current through U-ISO's isolation capacitance goes home through C-ISO-Y and not round NT-UMB-MOD, the star, AGND_MOD and the -12 V entry. Its leakage, 3.9 uH typ, adds to L-ISO-IN in the differential filter (power-entry.md)" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "Bourns" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "PM3700-40-RC" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "C2662215" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "machine" (at 294.64 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid 86c9ebff-4e73-45ec-9bac-2a2b3d2392b2))
    (pin "4" (uuid f9e07782-6cef-4fdb-98c4-653c13f95df7))
    (pin "2" (uuid 0fa103a1-68f8-4f8d-9975-1f8d665f40a5))
