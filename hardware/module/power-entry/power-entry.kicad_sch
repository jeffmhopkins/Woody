    (property "Pins_source" "a net tie's two pads: 1 PWR_GND (J-UMB-MOD pin 6), 2 DIG_GND (pin 8)" (at 243.84 370.84 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "PWR_GND to DIG_GND AT THE ETHERCON, between pins 6 and 8, copper only - the mirror of the instrument's NT-DIG (ADR 0018). The instrument's return comes back on both conductors and meets U-ISO's 0V here, so none of it crosses the DIG_GND plane to the star (dig-gnd-topology)" (at 243.84 370.84 0) (effects (font (size 1.27 1.27)) hide))
