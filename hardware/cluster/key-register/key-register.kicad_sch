  (junction (at 101.6 76.2) (diameter 0) (color 0 0 0 0) (uuid 1ffde9f4-c648-592b-b359-c1e9b1059465))
  (text "ONE SCHEMATIC, FOUR INSTANCES: right_thumb and left_thumb on the main board, right_hand and left_hand on the key boards (ADR 0017).\nCHAIN_SER and CHAIN_QH are per instance; which register sits on which hop is the key-chain netlist's hop map.\nA..H are the eight parallel inputs. Each board wires them to a key network, a marker strap or a free-bit pull-up, per\nhardware/cluster/key-marker-and-bits/allocation.yaml. H is the first bit out.\nCLK INH is tied low, permanently. QH_BAR is an output: do not ground it." (at 20.32 160.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 3f65d374-28ca-5b9b-9d5b-5423191a1eeb))
  (sheet_instances (path "/" (page "1")))
