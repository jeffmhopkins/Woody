  (junction (at 101.6 101.6) (diameter 0) (color 0 0 0 0) (uuid 24f936e4-b769-5a09-a39b-aec63be41e6f))
  (text "ONE CIRCUIT, ONE INSTANCE PER SWITCH POSITION: 19 fitted keys and the 2 reserved spare-switch positions.\nR-KEY-PU pulls the register input to 3V3; C-KEY and R-KEY-SER sit AT the register input, millimetres from the switch;\nthe switch pulls the node to ground. KEY_BITS goes to one of the register's inputs A..H, chosen per board.\nThe switch leg goes to GROUND: pressed = pulled LOW. The BOM buys 21 R-KEY-SER and C-KEY but 24 R-KEY-PU:\nthe three free bits carry a pull-up and nothing else (cluster/key-marker-and-bits)." (at 20.32 140.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid c161adc8-5750-5ab2-a0bc-3c7931a37071))
  (sheet_instances (path "/" (page "1")))
