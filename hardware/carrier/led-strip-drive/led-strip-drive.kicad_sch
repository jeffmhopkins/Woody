    (property "Row" "U-LVLSHIFT" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "1A=2 1Y=3 1OE=1 2A=5 2Y=6 2OE=4 3A=9 3Y=8 3OE=10 4A=12 4Y=11 4OE=13 VCC=14 GND=7" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "ON THE 5 V RAIL, and that is the point: TTL thresholds mean a 3.3 V input reads high, and the output (~4.4 V minimum) clears the WS2815B-V1 V_IH (2.7 V min) and stays under its 5.7 V logic-input maximum. Gates B, C and D are spare: the row has one data line, and LED 1 grounds its DIN2 rather than having it driven" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/logic/SN74AHCT125.pdf p.1 pin-out (SOIC-14): 1OE 1, 1A 2, 1Y 3, 2OE 4, 2A 5, 2Y 6, GND 7, 3Y 8, 3A 9, 3OE 10, 4Y 11, 4A 12, 4OE 13, VCC 14" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "Texas Instruments" (at 40.64 50.8 0) (effects (font (size 1.27 1.27)) hide))
