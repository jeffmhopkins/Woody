    (property "Pins" "1=1 2=2" (at 127 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "U0RXD's series resistor (pre-fab review S3, 2026-11-22), beside HDR-SERVICE pin 2: it limits what a strike on the pin, or an adapter at the wrong voltage, can push into IO44, as R-TXD-SER does for IO43. 1 kohm against the pad's input leakage and a UART's edge rate costs nothing" (at 127 50.8 0) (effects (font (size 1.27 1.27)) hide))
