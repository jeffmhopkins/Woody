  (text "FROM THE HAND-WRITTEN NETLIST THIS SHEET REPLACES (verbatim; the part notes are on each part's Note field):\n\nAUTHORITATIVE for connectivity. This circuit is one header, the conductors to it, R-TXD-SER in TXD and C-EN on\nEN (Espressif's guidelines, #14 A2/A3), and the drawing in the page is a REPRESENTATION of this file. Whatever is plugged into the service header is not part of the\ninstrument, so hardware/nets.yaml marks that end with `external_driver:` rather than inventing a driver or\ncalling the net undriven." (at 205.74 38.099999999999994 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 18a0b6f3-6f29-5346-99e1-ce2c083846d6))
  (symbol (lib_id "Device:R") (at 101.60 50.80 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid 54a011eb-ec0b-4ace-843f-10e9245dc62f)
    (property "Reference" "R-TXD-SER" (at 104.14 49.53 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "499R 1%" (at 104.14 52.07 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "R-TXD-SER" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "1=1 2=2" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "U0TXD's series resistor (#14 A3, #11 F7): Espressif asks for 499 ohm in series with U0TXD 'to suppress harmonics' [ds logic/ESP-HARDWARE-DESIGN-GUIDELINES-ESP32S3.pdf p.16, 1.3.7 UART]. Here it is the first part on IO43 after the ribbon, at J-MCU pin 22, and it also limits what a strike on HDR-SERVICE pin 1 can push into the pin. 499 ohm against a UART receiver's input is nothing at 115200 baud" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "a two-terminal resistor" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "UNI-ROYAL(Uniroyal Elec)" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "0805W8F4990T5E" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "C17722" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "machine" (at 101.60 50.80 0) (effects (font (size 1.27 1.27)) hide))
