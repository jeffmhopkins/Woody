  (symbol (lib_id "Device:R") (at 142.24 106.68 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid 2ed0ae7f-2c76-412c-b901-77991908fc12)
    (property "Reference" "R-ADC-VDD" (at 144.78 105.41 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "10R 1%" (at 144.78 107.95 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "R-ADC-VDD" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "1=1 2=2" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "D1 (owner, 2026-10-03: '10 ohm + 22 uF + 10 uF'): in series from DEV_3V3 to ADC_VDD, U-ADC pin 8 (VDD, which IS the reference). With C-ADC-VDD, C-ADC-BULK and C-DEC-ADC at the pin it filters the R-78E5.0's ripple off the reference (breath-adc/sim vdd-ripple); the capacitance at the pin carries each conversion's current, so the resistor does not sag the reference inside one (vdd-load). Its DC drop is U-ADC's few hundred uA through it: a gain term" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "a two-terminal resistor" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "UNI-ROYAL(Uniroyal Elec)" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "0805W8F100JT5E" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "C17415" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "machine" (at 142.24 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid 93af1222-9227-4a6e-a104-188e191ee668))
    (pin "2" (uuid 7927987c-00e6-406c-9bf6-da6cda643f39))
