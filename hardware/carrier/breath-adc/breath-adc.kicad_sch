  (text "FROM THE HAND-WRITTEN NETLIST THIS SHEET REPLACES (verbatim; the part notes are on each part's Note field):\n\nAUTHORITATIVE for connectivity. THE DRAWING IS ON ANOTHER PAGE - carrier.md §2 draws the whole breath path in\none picture. This circuit is the divider and the MCP3202 at the end of it.\n\nCH1 is tied to AGND_INST (owner, 2026-10-03, D5). U-ADC's VDD = VREF is ADC_VDD, filtered from DEV_3V3\nby R-ADC-VDD with C-ADC-VDD, C-ADC-BULK and C-DEC-ADC at pin 8 (owner, 2026-10-03, D1)." (at 256.54 38.099999999999994 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid e9b16af4-7bcf-5304-b518-b36f1717e537))
  (symbol (lib_id "Device:R") (at 91.44 106.68 0) (unit 1)
    (in_bom yes) (on_board yes) (dnp no)
    (uuid 08dd7270-8ba8-415a-984e-94f05bddf5d3)
    (property "Reference" "R-CS-PULL-ADC" (at 93.98 105.41 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "10k 1%" (at 93.98 107.95 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Resistor_SMD:R_0805_2012Metric" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Row" "R-CS-PULL-ADC" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins" "1=1 2=2" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "CS_ADC's idle pull-up (#11 F5): IO39 to DEV_3V3, beside U-ADC pin 1. IO39 is MTCK, whose weak pull-up at reset depends on an eFuse - 'IE 7', note 7: EFUSE_DIS_PAD_JTAG 0, WPU enabled; 1, pin floating [ds ESP32-S3-datasheet-v2.2.pdf p.17-18] - and ESP-IDF burns that fuse when secure boot is built for release [from memory]. This holds U-ADC deselected from reset until the firmware drives the pin whatever the fuses say, as R-CS-PULL-INST holds CS_MOD on the same shared host. IO39 is not a strapping pin (GPIO0/3/45/46, p.26)" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "a two-terminal resistor" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Manufacturer" "UNI-ROYAL(Uniroyal Elec)" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "MPN" "0805W8F1002T5E" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "LCSC" "C17414" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (property "Assembly" "machine" (at 91.44 106.68 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid 8c4079ad-df7c-47e3-be22-f23dc2825192))
    (pin "2" (uuid 6e266b65-df50-4976-b8b0-5b996e3f2b58))
