    (property "Pins" "1=1 2=2" (at 60.96 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (property "Note" "TIP's series resistor, CA-033 Figure 1's 5 V row (220 ohm 5 % 0.25 W) [ds connectors/MIDI-CA-033-ELECTRICAL-SPEC-UPDATE-2014.pdf p.3]. It is RA when the tip is the source (Type B) and RC when it is the sink (Type A): the two lines are identical so the choice is firmware's. Limits a short of the tip to the sleeve to 5.0 V / 209 ohm = 23.9 mA, inside U-LVLSHIFT's 25 mA continuous rating (midi-out.md)" (at 60.96 50.8 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid be8e1df2-3fce-50fc-bf2e-c2801526da5b))
