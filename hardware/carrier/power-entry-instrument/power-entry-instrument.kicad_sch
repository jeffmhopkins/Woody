    (property "Note" "Ideal-diode controller for the 5 V OR (issue #39, owner 2026-10-05): drives Q-USBOR so the buck's 5 V reaches INST_5V_A 20 mV down instead of an SS14's 0.5 V, and turns it off when INST_5V_A is above BUCK_A_OUT (the Matrix's USB-C 5 V through its D1), so neither source back-feeds the other. EN tied to ANODE: always on" (at 325.12 157.48 0) (effects (font (size 1.27 1.27)) hide))
    (property "Pins_source" "datasheets/discrete-and-power/TI-LM74700-Q1.pdf p.3, DBV: 1 VCAP, 2 GND, 3 EN, 4 CATHODE, 5 GATE, 6 ANODE" (at 325.12 157.48 0) (effects (font (size 1.27 1.27)) hide))
