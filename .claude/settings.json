{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/commit-gate.py\" || true",
            "timeout": 240,
            "statusMessage": "Commit gate: checking the corpus..."
          }
        ]
      }
    ]
  }
}
